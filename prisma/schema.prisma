generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum UserRank {
  E_RANK
  D_RANK
  C_RANK
  B_RANK
  A_RANK
  S_RANK
}

enum QuestDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestStatus {
  AVAILABLE
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum QuestType {
  POSITIVE
  NEGATIVE
}

enum ActivityType {
  QUEST_COMPLETED
  QUEST_FAILED
  LEVEL_UP
  ACHIEVEMENT_UNLOCKED
  PENALTY_APPLIED
  STAT_INCREASED
}

// ==================== MODELS ====================

model User {
  id               String    @id @default(uuid())
  username         String    @unique
  password         String
  title            String    @default("Player")
  
  // RPG Stats
  rank             UserRank  @default(E_RANK)
  level            Int       @default(1)
  maxHp            Int       @default(3000)
  currentHp        Int       @default(3000)
  maxMp            Int       @default(500)
  currentMp        Int       @default(500)
  currentXp        Int       @default(0)
  xpToNextLevel    Int       @default(10000)
  gold             Int       @default(0)
  
  // Progression
  streakDays       Int       @default(0)
  lastActivityDate DateTime?
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  stats            Stats?
  quests           Quest[]
  achievements     Achievement[]
  activityLogs     ActivityLog[]

  @@map("users")
}

model Stats {
  id              String @id @default(uuid())
  userId          String @unique
  
  strength        Int    @default(10)
  agility         Int    @default(10)
  intelligence    Int    @default(10)
  vitality        Int    @default(10)
  availablePoints Int    @default(0)

  // Relation
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("stats")
}

model Quest {
  id              String          @id @default(uuid())
  userId          String
  title           String
  description     String?
  difficulty      QuestDifficulty @default(EASY)
  status          QuestStatus     @default(AVAILABLE)
  type            QuestType       @default(POSITIVE)
  
  currentProgress Int             @default(0)
  targetProgress  Int
  unit            String
  
  goldReward      Int             @default(0)
  xpReward        Int             @default(0)
  statReward      String?
  
  hpPenalty       Int             @default(0)
  statPenalty     Int             @default(0)
  statPenaltyType String?
  
  deadline        DateTime?
  isDaily         Boolean         @default(false)
  isRecurring     Boolean         @default(false)
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relation
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([isDaily])
  @@map("quests")
}

model Achievement {
  id          String    @id @default(uuid())
  userId      String
  name        String
  description String
  icon        String
  unlocked    Boolean   @default(false)
  unlockedAt  DateTime?
  condition   String?
  
  createdAt   DateTime  @default(now())

  // Relation
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([unlocked])
  @@map("achievements")
}

model ActivityLog {
  id        String       @id @default(uuid())
  userId    String
  type      ActivityType
  message   String
  icon      String?
  metadata  Json?
  
  createdAt DateTime     @default(now())

  // Relation
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}

model RevokedToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("revoked_tokens")
}